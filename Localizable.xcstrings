    "settings.dataSources.providerDescription" : {
      "comment" : "Description of the data.gov.hk data source.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transit data provided in this app is retrieved via the data.gov.hk API. While we strive to ensure the accuracy of the information displayed, we cannot guarantee the reliability, completeness, or timeliness of these data feeds."
          }
        },
        "zh-Hans-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用提供的交通数据通过 data.gov.hk API 获取。虽然我们致力于确保所显示信息的准确性，但无法保证这些数据源的可靠性、完整性或时效性。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本應用程式提供的交通資料透過 data.gov.hk API 取得。雖然我們致力確保所顯示資訊的準確性，但無法保證這些資料來源的可靠性、完整性或時效性。"
          }
        }
      }
    },
    "settings.dataSources.referenceOnly" : {
      "comment" : "Reference-only disclaimer shown on the data sources screen.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please use this information for reference only; service schedules may be subject to change due to traffic or operational conditions. We are not responsible for any direct or indirect losses resulting from the use of this service."
          }
        },
        "zh-Hans-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请仅作参考；服务时间表可能因交通或运营情况而有所变动。对于因使用本服务造成的任何直接或间接损失，我们概不负责。"
